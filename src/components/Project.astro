---
interface Props {
  name: string;
  url: string;
  subtitle: string;
  description: string;
}
const { name, url, subtitle, description } = Astro.props;
---

<div class="project pl-3 mb-4 border-l-2 border-green-400 bg-gray-50 rounded">
  <h4 class="text-lg font-medium">
    <a 
      href={url} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="text-green-600 font-semibold no-underline hover:text-green-700"
    >
      {name}
    </a>
  </h4>
  <p class="text-xs text-gray-600">{subtitle}</p>
  <p class="mt-1 text-sm text-gray-700">{description}</p>
</div>
