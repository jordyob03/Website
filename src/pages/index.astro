---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import CoverPhoto from '../assets/CoverPhoto.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="hero-image mb-8">
				<img src={CoverPhoto.src} alt="Cover photo" />
			</div>

			<div class="prose">
				<div class="title" style="text-align: center;">
					<h1>About Me</h1>
					<hr />
				</div>

				<p>
					Hi, I'm Jordyn/Jordy O'Brien! I'm a first year Master's student at
					University of Toronto studying computer engineering. My research
					focuses on security in advanced AI systems. I work in the Toronto
					Systems Security Lab where I'm supervised by Dr. David Lie. I grew up in Newfoundland and completed my undergraduate degree there. Outside of school I like running, cooking, reading and traveling.
				</p>
			</div>
		</main>

		<Footer />
	</body>
</html>